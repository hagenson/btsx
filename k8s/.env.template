# BTSX Web Application Environment Configuration Template
# Copy this file to .env and fill in the actual values

# Encryption key for securing stored credentials (required)
# Generate with: openssl rand -base64 32
# Windows: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
Persistence__EncryptionKey=your-base64-encoded-32-byte-encryption-key-here

# Google OAuth Client ID (required for Google OAuth authentication)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GoogleOAuth__ClientId=your-google-oauth-client-id.apps.googleusercontent.com

# Google OAuth Client Secret (required for Google OAuth authentication)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GoogleOAuth__ClientSecret=your-google-oauth-client-secret

# Google OAuth Redirect URI (required for OAuth callback)
# Must match the redirect URI configured in Google Cloud Console
# Format: https://your-domain.com/oauth/callback
GoogleOAuth__RedirectUri=https://your-domain.com/oauth/callback

# Support email address (displayed in the application UI)
# Used for user support and contact information
AppConfig__SupportEmail=support@your-domain.com
